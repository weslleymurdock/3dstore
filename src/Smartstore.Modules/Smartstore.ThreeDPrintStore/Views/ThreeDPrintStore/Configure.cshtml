@{
    Layout = "_ConfigureModule";
}

<div class="alert alert-info">
    <h4>@T("Plugins.ThreeDPrintStore.Configuration.Title")</h4>
    <p class="mb-0">@T("Plugins.ThreeDPrintStore.Configuration.Description")</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@T("Plugins.ThreeDPrintStore.Configuration.Status")</h5>
        <p class="card-text">@T("Plugins.ThreeDPrintStore.Configuration.Installed")</p>
    </div>
</div>
